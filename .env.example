# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Koyeb)
# ==========================================
NODE_ENV=production
# Koyeb sets PORT automatically (defaults to 8000)
PORT=8000

# Your Vercel frontend URL(s)
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

# Database & Stripe
DATABASE_URL=postgresql://user:password@host:5432/dbname
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# Note: In Vite, these MUST start with VITE_
# and are baked into the build on Vercel.
# ==========================================
VITE_API_URL=https://your-app.koyeb.app
VITE_WS_URL=wss://your-app.koyeb.app

# Public link to the app installer shown at the bottom of the login page
# (Microsoft Store listing, Google Play listing, or a hosted .msix/.exe file).
# Leave empty to show "App download coming soon" instead of a dead link.
VITE_APP_DOWNLOAD_URL=